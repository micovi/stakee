---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { sitePath } from '~/lib/repo';

const base = import.meta.env.BASE_URL;
---

<StarlightPage
  frontmatter={{
    title: 'Page not found',
    template: 'splash',
    editUrl: false,
    pagefind: false,
    hero: {
      tagline: 'This page does not exist. Try the search, or start from the model catalogue.',
      actions: [
        { text: 'Browse models', link: sitePath(base, 'models/'), icon: 'right-arrow' },
        { text: 'Home', link: base, variant: 'minimal' },
      ],
    },
  }}
/>
